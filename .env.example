# Copier ce fichier en .env.local et renseigner les vraies valeurs.

# Stripe — tableau de bord Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=
# Stripe → Développeurs → Webhooks → point de terminaison /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Paramètres du projet → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role — jamais exposée au navigateur, utilisée uniquement par le webhook Stripe
SUPABASE_SERVICE_ROLE_KEY=
